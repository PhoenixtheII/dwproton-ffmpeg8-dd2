#!/bin/bash
# Launcher for the custom DWProton + FFmpeg 8.1.3 Dragon's Dogma 2 build.
#
# Required game setup:
#   - dinput8.dll from REFramework 01422
#   - reframework/autorun/intro_skip.lua
#   - OnlineFix.ini with EmulateTicket=true
#   - host Steam running and logged in
set -e

GAME_DIR="${DD2_GAME_DIR:-$HOME/games/Dragons Dogma 2}"
PROTON_DIR="${DD2_PROTON_DIR:-$HOME/games/dwproton-media-clean}"
WINEPREFIX="${DD2_PREFIX:-$HOME/games/dd2-media}"

cd "$GAME_DIR"

export PROTON_DISABLE_LSTEAMCLIENT=0
export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.local/share/Steam}"
export WINEPREFIX
export WINEDLLOVERRIDES="GameAssembly=n;Custom=n;OnlineFix64=n;SteamOverlay64=n;winmm=n,b;dnet=n;steam_api64=n;winhttp=n,b;version=n,b"
export PROTONPATH="$PROTON_DIR"
export GAMEID=umu-480

# Keep the requested output resolution.
if [ -f config.ini ]; then
    sed -i 's/^Resolution=.*/Resolution=2800x1752/' config.ini
fi

[ "$#" -eq 0 ] && set -- ./DD2.exe

exec "$HOME/bin/umu-run" "$@"
