+        LONGLONG file_size;
+    } winedmo_stream;
+
+    /* Set TRUE to make the read callback return 0 bytes (interrupts demuxer). */
+    BOOL read_flushing;
+    unsigned int read_flush_generation;
+
+    CRITICAL_SECTION streaming_cs;
+    CONDITION_VARIABLE flushing_cv;
+    bool streaming;
+    bool sink_connected;
+    bool flushing;
+    bool downstream_flushing;
