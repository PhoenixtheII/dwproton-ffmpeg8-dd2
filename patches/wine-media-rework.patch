-    {
-        const WAVEFORMATEXTENSIBLE *ext_format = (const WAVEFORMATEXTENSIBLE *)mt->pbFormat;
-
-        format->u.audio.channel_mask = ext_format->dwChannelMask;
-    }
-    else
-    {
