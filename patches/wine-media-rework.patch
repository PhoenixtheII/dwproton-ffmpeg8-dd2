-        {&MEDIASUBTYPE_PCM,          8, WG_AUDIO_FORMAT_U8},
-        {&MEDIASUBTYPE_PCM,         16, WG_AUDIO_FORMAT_S16LE},
-        {&MEDIASUBTYPE_PCM,         24, WG_AUDIO_FORMAT_S24LE},
