+    filter->source_get_media_type = dmo_generic_source_get_media_type;
+    filter->enum_sink_first = TRUE;
+    filter->max_queued_packets = 256;
+
+    TRACE("Created MPEG-1 splitter (winedmo) %p.\n", filter);
+    *out = &filter->filter.IUnknown_inner;
+    return S_OK;
+}
