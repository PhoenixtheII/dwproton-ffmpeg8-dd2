-static bool compare_media_types(const AM_MEDIA_TYPE *a, const AM_MEDIA_TYPE *b)
-{
-    return IsEqualGUID(&a->majortype, &b->majortype)
-            && IsEqualGUID(&a->subtype, &b->subtype)
