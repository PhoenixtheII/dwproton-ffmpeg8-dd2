-        {
-            format->u.audio.format = format_map[i].format;
-            return true;
-        }
-    }
-
-    FIXME("Unknown subtype %s, depth %u.\n", debugstr_guid(&mt->subtype), audio_format->wBitsPerSample);
-    return false;
