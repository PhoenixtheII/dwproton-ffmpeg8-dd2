-    if (!(caps = caps_strip_fields(transform->desired_caps, strip_size)))
-        return false;
-
-    if (filter)
-    {
-        temp = gst_caps_intersect(caps, filter);
-        gst_caps_unref(caps);
-        caps = temp;
-    }
-
-    GST_INFO("Returning caps %" GST_PTR_FORMAT, caps);
