-        WG_VIDEO_FORMAT_YUY2,
-        WG_VIDEO_FORMAT_UYVY,
-        WG_VIDEO_FORMAT_BGR,
-        WG_VIDEO_FORMAT_BGRx,
-        WG_VIDEO_FORMAT_RGB16,
