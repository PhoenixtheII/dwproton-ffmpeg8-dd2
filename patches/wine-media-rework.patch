-/* Call pthread_mutex_unlock() to unlock after usage. */
-static struct audio_conv_state *audio_conv_lock_state(AudioConv *conv)
-{
-    pthread_mutex_lock(&conv->state_mutex);
-    if (!conv->state)
-        pthread_mutex_unlock(&conv->state_mutex);
