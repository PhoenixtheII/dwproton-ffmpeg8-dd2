+static void video_decoder_update_observed_duration(struct video_decoder *decoder, INT64 pts, INT64 *duration)
+{
+    LONGLONG delta;
+
+    if (pts == INT64_MIN)
+        return;
+
+    if (decoder->last_output_pts != INT64_MIN)
+    {
+        delta = pts - decoder->last_output_pts;
+        if (delta > 0 && delta < 1000000 && delta > decoder->observed_output_duration)
+            decoder->observed_output_duration = delta;
+    }
+
+    decoder->last_output_pts = pts;
+
+    if (decoder->observed_output_duration > 0
+            && (*duration == INT64_MIN || *duration <= 0))
+        *duration = decoder->observed_output_duration;
+}
