+static INT64 clamp_runaway_video_pts(struct video_decoder *decoder, INT64 pts, INT64 duration)
+{
+    INT64 expected, threshold;
+
+    if (pts == INT64_MIN || decoder->sample_time == -1) return pts;
+    if (!is_mpeg4_part2_decoder(decoder)) return pts;
+
+    expected = decoder->sample_time;
+
+    if (pts <= expected) return expected;
+
+    threshold = duration > 0 ? duration * 4 : 1000000;
+    if (threshold < 1000000) threshold = 1000000;
+
+    if (pts > expected + threshold)
+        return expected;
+
+    return pts;
+}
