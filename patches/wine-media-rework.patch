-        if (!gst_buffer_pool_set_config(GST_BUFFER_POOL(pool), config))
-            GST_ERROR("Failed to set %"GST_PTR_FORMAT" config.", pool);
-    }
-
-    GST_INFO("Created %"GST_PTR_FORMAT, pool);
