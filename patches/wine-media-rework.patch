+    wfx = (const WAVEFORMATEX *)type->pbFormat;
+    if (type->cbFormat < sizeof(*wfx) + wfx->cbSize)
+        return FALSE;
+
+    if (!wfx->nChannels || !wfx->nSamplesPerSec || !wfx->nBlockAlign)
+        return FALSE;
+
+    return TRUE;
+}
